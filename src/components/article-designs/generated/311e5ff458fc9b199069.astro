---
import type { CollectionEntry } from "astro:content";
import {
	groupArticleBlocks,
	type ArticleSource,
} from "../../../utils/article-source";
import SourceBlock from "../SourceBlock.astro";
import PageShell from "../PageShell.astro";
import PageNavigation from "../PageNavigation.astro";
import PageTOC from "../PageTOC.astro";
import PageComments from "../PageComments.astro";
import PageFooter from "../PageFooter.astro";
import PagePagination from "../PagePagination.astro";
import ArticleContent from "../ArticleContent.astro";
import ExperienceFooter from "../ExperienceFooter.astro";
import PostMeta from "../../PostMeta.astro";

interface Props {
	entry: CollectionEntry<"posts">;
	article: ArticleSource;
	designKey: string;
}
const { entry, article, designKey } = Astro.props;

/* 原文按 h1/h2 分组：第一组是标题与引言，其余每组一章。 */
const groups = groupArticleBlocks(article, 2);
const firstGroup = groups[0] ?? [];
const titleBlock = firstGroup[0]?.tag === "h1" ? firstGroup[0] : null;
const introBlocks = titleBlock ? firstGroup.slice(1) : firstGroup;
const chapterGroups = titleBlock ? groups.slice(1) : groups;
const chapters = chapterGroups.map((blocks) => {
	const head = blocks[0];
	const heading =
		head?.headingId && /^h[12]$/.test(head.tag) ? head.headingId : "";
	return { blocks, headingId: heading };
});

/* 面板初始字形：上电默认 000010。JS 里使用同一张字形表。 */
const SEGMENTS: Record<string, string> = {
	"0": "abcdef",
	"1": "bc",
	"2": "abdeg",
	"3": "abcdg",
	"4": "bcfg",
	"5": "acdfg",
	"6": "acdefg",
	"7": "abc",
	"8": "abcdefg",
	"9": "abcdfg",
};
const SEG_ORDER = ["a", "b", "c", "d", "e", "f", "g"];
const POWER_ON_DIGITS = "000010".split("");

const toggles = [
	{ key: "1", label: "K1", role: "反光板 + 许可" },
	{ key: "2", label: "K2", role: "许可" },
	{ key: "3", label: "K3", role: "许可" },
];
---

<PageShell entry={entry} designKey={designKey} class="sw-page-shell">
	<PageNavigation class="sw-nav" />

	<shutter-wire-page class="sw-page">
		<ArticleContent entry={entry} article={article} class="sw-content">
			<!-- ── 规格头 + 面板演示 ───────────────────────────── -->
			<header class="sw-hero">
				<div class="sw-hero-head">
					<p class="sw-kicker">
						<span class="sw-kicker-led" aria-hidden="true"></span>
						ShutterWire · STM32L051C8T6
					</p>
					<div data-pagefind-body>
						{
							titleBlock ? (
								<SourceBlock
									block={titleBlock}
									prose={false}
									class="sw-title-block"
								/>
							) : (
								<h1 data-pagefind-meta="title">{entry.data.title}</h1>
							)
						}
					</div>
					<PostMeta
						className="sw-meta"
						published={entry.data.published}
						updated={entry.data.updated}
						tags={entry.data.tags}
						category={entry.data.category || undefined}
						id={entry.id}
					/>
				</div>

				<!-- 面板演示：按文中 K1–K7 与状态机规则联动 -->
				<shutter-wire-panel class="sw-panel" data-pagefind-ignore>
					<div class="sw-panel-bar">
						<span class="sw-panel-tag">面板演示</span>
						<span class="sw-panel-legend"
							>指示灯：绿＝对应接点闭合，红＝未闭合</span
						>
					</div>

					<div class="sw-case">
						<div class="sw-case-controls">
							{
								toggles.map((item) => (
									<div class="sw-slot">
										<span
											class="sw-led is-red"
											data-sw-led={item.key}
											aria-hidden="true"
										/>
										<button
											type="button"
											class="sw-switch"
											data-sw-toggle={item.key}
											role="switch"
											aria-checked="false"
											aria-label={`${item.label} 钮子开关，${item.role}`}
										>
											<span class="sw-bezel" aria-hidden="true">
												<span class="sw-lever" />
											</span>
											<span class="sw-slot-label">
												<span class="sw-slot-key">{item.label}</span>
												<span class="sw-slot-role">{item.role}</span>
											</span>
										</button>
									</div>
								))
							}
							<div class="sw-slot sw-slot-shutter">
								<span
									class="sw-led is-red"
									data-sw-led="7"
									aria-hidden="true"
								/>
								<button
									type="button"
									class="sw-latch"
									data-sw-shutter
									aria-pressed="false"
									aria-label="K7 自锁快门按钮"
								>
									<span class="sw-latch-cap" aria-hidden="true" />
									<span class="sw-slot-label">
										<span class="sw-slot-key">K7</span>
										<span class="sw-slot-role">快门（自锁）</span>
									</span>
								</button>
							</div>
						</div>

						<div class="sw-display">
							<div class="sw-digits" data-sw-digits aria-hidden="true">
								{
									POWER_ON_DIGITS.map((char, index) => (
										<span class="sw-digit" data-sw-digit={index}>
											{SEG_ORDER.map((seg) => (
												<i
													class:list={[
														"sw-seg",
														`sw-seg-${seg}`,
														{ "is-on": SEGMENTS[char].includes(seg) },
													]}
												/>
											))}
										</span>
									))
								}
							</div>
							<dl class="sw-readout" aria-live="off">
								<div>
									<dt>状态</dt>
									<dd data-sw-phase>待机 IDLE</dd>
								</div>
								<div>
									<dt>余量</dt>
									<dd data-sw-remain>2560 tick · 10.000 s</dd>
								</div>
								<div>
									<dt>IN1–OUT1</dt>
									<dd data-sw-out1>断开</dd>
								</div>
								<div>
									<dt>IN2–OUT2</dt>
									<dd data-sw-out2>断开</dd>
								</div>
								<div>
									<dt>调时</dt>
									<dd data-sw-unit>选中 秒</dd>
								</div>
							</dl>
						</div>

						<div class="sw-case-keys">
							<div class="sw-key">
								<button
									type="button"
									class="sw-key-cap"
									data-sw-key="4"
									aria-label="K4 增加选中单位的时间"
									><span aria-hidden="true">＋</span></button
								>
								<span class="sw-slot-key">K4</span>
								<span class="sw-slot-role">增加</span>
							</div>
							<div class="sw-key">
								<button
									type="button"
									class="sw-key-cap"
									data-sw-key="5"
									aria-label="K5 确认并切换单位，长按两秒退出暂停"
									><span aria-hidden="true">◉</span></button
								>
								<span class="sw-slot-key">K5</span>
								<span class="sw-slot-role">确认 / 切换</span>
							</div>
							<div class="sw-key">
								<button
									type="button"
									class="sw-key-cap"
									data-sw-key="6"
									aria-label="K6 减少选中单位的时间"
									><span aria-hidden="true">－</span></button
								>
								<span class="sw-slot-key">K6</span>
								<span class="sw-slot-role">减少</span>
							</div>
						</div>
					</div>

					<div class="sw-panel-foot">
						<p class="sw-note" data-sw-note aria-live="polite">
							上电初始状态：K1～K3 弹起，K7 弹起，设定 10 秒。
						</p>
						<div class="sw-panel-actions">
							<p class="sw-hint">
								点开关＝闭合接点；点 K7＝一次操作；按住 K4／K6 约
								600 ms 连调；按住 K5 两秒退出暂停。
							</p>
							<button type="button" class="sw-power" data-sw-power>
								重新上电
							</button>
						</div>
					</div>
				</shutter-wire-panel>

				<p class="sw-disclaimer">
					面板按文中 K1–K7、逐输入消抖 31.25 ms、四状态机与 1/256
					s 余量规则实现，只用于对照阅读；文中的硬件验证状态以原文为准。
				</p>
			</header>

			<!-- ── 正文 ─────────────────────────────────────── -->
			<div class="sw-layout">
				<div class="sw-chapters" data-pagefind-body>
					{
						introBlocks.length > 0 && (
							<section
								class="sw-chapter sw-intro"
								data-sw-chapter="intro"
							>
								<span class="sw-probe" aria-hidden="true" />
								<div class="sw-chapter-body">
									{introBlocks.map((block) => (
										<SourceBlock block={block} prose={false} />
									))}
								</div>
							</section>
						)
					}
					{
						chapters.map((chapter, index) => (
							<section
								class="sw-chapter"
								data-sw-chapter={index}
								data-sw-heading={chapter.headingId}
							>
								<span class="sw-probe" aria-hidden="true" />
								<div class="sw-chapter-body">
									{chapter.blocks.map((block) => (
										<SourceBlock block={block} prose={false} />
									))}
								</div>
							</section>
						))
					}
				</div>

				<aside class="sw-side">
					<div class="sw-side-sticky">
						<PageTOC label="章节" class="sw-toc" />
					</div>
				</aside>
			</div>

			<div class="sw-license">
				<ExperienceFooter entry={entry} />
			</div>
		</ArticleContent>

		<PageComments entry={entry} class="sw-comments" />
		<PagePagination entry={entry} class="sw-pagination" />
		<PageFooter />
	</shutter-wire-page>

	<style is:inline>
		/* ── tokens ───────────────────────────────────────── */
		[data-article-design="311e5ff458fc9b199069"] {
			--sw-mono: ui-monospace, "SFMono-Regular", "Cascadia Mono", Consolas,
				monospace;
			--sw-hair: var(--line-divider, rgba(128, 128, 128, 0.24));
			--sw-plate: var(--card-bg, rgba(127, 127, 127, 0.06));
			--sw-ink-soft: color-mix(in srgb, currentColor 72%, transparent);
			--sw-ink-faint: color-mix(in srgb, currentColor 48%, transparent);
			--sw-tint: color-mix(in srgb, var(--primary) 12%, transparent);
			--sw-tint-strong: color-mix(in srgb, var(--primary) 30%, transparent);
			--sw-red: #dd5a4d;
			--sw-green: #38ac71;
			--sw-display: #14161b;
			/* 本文专用强调色：只要示仪器与导航的指示，与全站主题色分开。
			   正文链接、发光显示仍用 --primary。 */
			--sw-accent: #0c6a62;
			--sw-accent-soft: color-mix(in srgb, var(--sw-accent) 16%, transparent);
			--sw-accent-strong: color-mix(
				in srgb,
				var(--sw-accent) 42%,
				transparent
			);
			/* 工程图纸网格：亮色像图纸台，暗色像未开灯的台架。
			   纸底与主题 card-bg 混合，抬高不透明度以压平正文背后的全站纹理。 */
			--sw-paper: color-mix(in srgb, var(--card-bg) 58%, #ffffff 42%);
			--sw-grid-line: color-mix(in srgb, var(--sw-accent) 4%, transparent);
			--sw-grid-line-strong: color-mix(
				in srgb,
				var(--sw-accent) 7%,
				transparent
			);
		}
		.dark [data-article-design="311e5ff458fc9b199069"] {
			--sw-accent: #e0a45c;
			--sw-ink-soft: color-mix(in srgb, currentColor 78%, transparent);
			--sw-ink-faint: color-mix(in srgb, currentColor 56%, transparent);
			--sw-paper: color-mix(in srgb, var(--card-bg) 58%, #04060a 42%);
			--sw-grid-line: color-mix(in srgb, var(--sw-accent) 5%, transparent);
			--sw-grid-line-strong: color-mix(
				in srgb,
				var(--sw-accent) 9%,
				transparent
			);
		}

		/* 背景：1rem 细网格 + 8rem 坐标线，强度保持“几乎看不见”。 */
		[data-article-design="311e5ff458fc9b199069"] {
			background-color: var(--sw-paper);
			background-image:
				linear-gradient(
					to right,
					var(--sw-grid-line) 1px,
					transparent 1px
				),
				linear-gradient(
					to bottom,
					var(--sw-grid-line) 1px,
					transparent 1px
				),
				linear-gradient(
					to right,
					var(--sw-grid-line-strong) 1px,
					transparent 1px
				),
				linear-gradient(
					to bottom,
					var(--sw-grid-line-strong) 1px,
					transparent 1px
				);
			background-size:
				1rem 1rem,
				1rem 1rem,
				8rem 8rem,
				8rem 8rem;
		}

		[data-article-design="311e5ff458fc9b199069"] .sw-page {
			display: block;
		}

		/* ── 导航 ─────────────────────────────────────────── */
		[data-article-design="311e5ff458fc9b199069"] .sw-nav {
			position: sticky;
			top: 0;
			z-index: 60;
			background: color-mix(in srgb, var(--card-bg) 88%, transparent);
			backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--sw-hair);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-nav #navbar > div:last-child {
			max-width: none;
		}

		/* ── 规格头 ───────────────────────────────────────── */
		[data-article-design="311e5ff458fc9b199069"] .sw-hero {
			width: min(100% - 2.5rem, 84rem);
			margin: 2.25rem auto 0;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-kicker {
			display: flex;
			align-items: center;
			gap: 0.55rem;
			margin: 0 0 0.85rem;
			font-family: var(--sw-mono);
			font-size: 0.8rem;
			letter-spacing: 0.06em;
			color: var(--sw-ink-soft);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-kicker-led {
			width: 0.45rem;
			height: 0.45rem;
			border-radius: 50%;
			background: var(--sw-accent);
			box-shadow: 0 0 0.5rem var(--sw-accent-strong);
			animation: sw-power-led 2.4s ease-in-out infinite;
		}
		@keyframes sw-power-led {
			0%,
			100% {
				opacity: 0.45;
			}
			50% {
				opacity: 1;
			}
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-title-block h1 {
			margin: 0;
			font-size: clamp(1.75rem, 3.6vw, 2.85rem);
			line-height: 1.3;
			font-weight: 780;
			letter-spacing: -0.015em;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-title-block h1 .anchor {
			display: none;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-meta {
			margin-top: 1rem;
		}

		/* ── 面板外壳 ─────────────────────────────────────── */
		[data-article-design="311e5ff458fc9b199069"] .sw-panel {
			display: block;
			margin-top: 2rem;
			padding: clamp(0.9rem, 2vw, 1.35rem);
			border: 1px solid var(--sw-hair);
			border-radius: var(--radius-large);
			background:
				linear-gradient(
					color-mix(in srgb, currentColor 3%, transparent),
					transparent
				),
				var(--sw-plate);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-panel-bar {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.5rem 1rem;
			padding-bottom: 0.7rem;
			margin-bottom: 1rem;
			border-bottom: 1px dashed var(--sw-hair);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-panel-tag {
			font-family: var(--sw-mono);
			font-size: 0.78rem;
			font-weight: 600;
			padding: 0.15rem 0.5rem;
			border: 1px solid var(--sw-accent-strong);
			border-radius: 999px;
			color: var(--sw-accent);
			background: var(--sw-accent-soft);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-panel-legend,
		[data-article-design="311e5ff458fc9b199069"] .sw-hint,
		[data-article-design="311e5ff458fc9b199069"] .sw-disclaimer {
			font-size: 0.83rem;
			line-height: 1.7;
			color: var(--sw-ink-soft);
			margin: 0;
		}

		[data-article-design="311e5ff458fc9b199069"] .sw-case {
			display: grid;
			gap: clamp(1rem, 2.2vw, 1.6rem);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-case-controls {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0.5rem;
			align-items: start;
			max-width: 46rem;
			margin-inline: auto;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-slot {
			display: grid;
			justify-items: center;
			gap: 0.4rem;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-slot-shutter {
			grid-column: 4;
		}

		[data-article-design="311e5ff458fc9b199069"] .sw-led {
			width: 1.05rem;
			height: 1.05rem;
			border-radius: 50%;
			border: 1px solid var(--sw-hair);
			background-image: radial-gradient(
				circle at 34% 28%,
				rgba(255, 255, 255, 0.72),
				transparent 58%
			);
			background-color: color-mix(in srgb, currentColor 22%, transparent);
			transition:
				background-color 0.18s ease,
				box-shadow 0.18s ease;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-led.is-red {
			background-color: var(--sw-red);
			box-shadow: 0 0 0.5rem color-mix(in srgb, var(--sw-red) 55%, transparent);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-led.is-green {
			background-color: var(--sw-green);
			box-shadow: 0 0 0.5rem
				color-mix(in srgb, var(--sw-green) 55%, transparent);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-led.is-off {
			background-color: color-mix(in srgb, currentColor 16%, transparent);
			box-shadow: none;
		}

		[data-article-design="311e5ff458fc9b199069"] .sw-switch,
		[data-article-design="311e5ff458fc9b199069"] .sw-latch,
		[data-article-design="311e5ff458fc9b199069"] .sw-key-cap,
		[data-article-design="311e5ff458fc9b199069"] .sw-power {
			-webkit-tap-highlight-color: transparent;
			font: inherit;
			color: inherit;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-switch,
		[data-article-design="311e5ff458fc9b199069"] .sw-latch {
			display: grid;
			justify-items: center;
			gap: 0.45rem;
			padding: 0.3rem 0.25rem;
			background: none;
			border: 0;
			cursor: pointer;
			border-radius: 0.6rem;
		}
		[data-article-design="311e5ff458fc9b199069"] :is(
				.sw-switch,
				.sw-latch,
				.sw-key-cap,
				.sw-power
			):focus-visible {
			outline: 2px solid var(--primary);
			outline-offset: 2px;
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-bezel {
			position: relative;
			width: 1.45rem;
			height: 2.1rem;
			border-radius: 0.4rem;
			border: 1px solid var(--sw-hair);
			background: linear-gradient(
				color-mix(in srgb, currentColor 17%, transparent),
				color-mix(in srgb, currentColor 7%, transparent)
			);
			box-shadow:
				inset 0 2px 5px rgba(0, 0, 0, 0.3),
				0 1px 0 rgba(255, 255, 255, 0.12);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-lever {
			position: absolute;
			left: 50%;
			top: 0.16rem;
			width: 1rem;
			height: 1rem;
			margin-left: -0.5rem;
			border-radius: 50%;
			background:
				radial-gradient(
					circle at 34% 28%,
					rgba(255, 255, 255, 0.8),
					transparent 60%
				),
				linear-gradient(#c8cdd6, #8b919b);
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
			transition:
				top 0.14s ease,
				box-shadow 0.14s ease;
		}
		[data-article-design="311e5ff458fc9b199069"]
			.sw-switch[aria-checked="true"]
			.sw-lever {
			top: 0.9rem;
			box-shadow:
				0 1px 1px rgba(0, 0, 0, 0.4),
				inset 0 1px 2px rgba(255, 255, 255, 0.35);
		}
		[data-article-design="311e5ff458fc9b199069"] .sw-latch-cap {
			display: block;
			width: 1.6rem;
			height: 1.6rem;
			border-radius: 0.32rem;
			border: 1px solid var(--sw-hair);
			background: linear-gradient(
				color-mix(in srgb, currentColor 12%, transparent),
				color-mix(in srgb, currentColor 4%, transparent)
			);
			box-shadow:
