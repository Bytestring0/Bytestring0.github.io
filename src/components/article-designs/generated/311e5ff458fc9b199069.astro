			[data-article-design="311e5ff458fc9b199069"] .sw-panel-foot {
				display: none;
			}
			[data-article-design="311e5ff458fc9b199069"]
				.sw-chapter:is(.is-pending, .is-revealed) {
				opacity: 1;
				transform: none;
			}
		}
	</style>

	<script>
		type Phase = "IDLE" | "RUNNING" | "PAUSED" | "DONE";
		type Unit = "h" | "m" | "s";
		type InputKey = "1" | "2" | "3" | "7";

		interface InputSlot {
			position: boolean;
			stable: boolean;
			candidate: boolean;
			timer: number;
		}

		const TICKS_PER_SECOND = 256;
		const TICK_MS = 1000 / TICKS_PER_SECOND;
		const DEFAULT_SECONDS = 10;
		const MIN_SECONDS = 1;
		const MAX_SECONDS = 99 * 3600 + 59 * 60 + 59;
		const DEBOUNCE_MS = 31.25;
		const LONG_PRESS_MS = 2000;
		const REPEAT_DELAY_MS = 600;
		const REPEAT_INTERVAL_MS = 100;
		const BLANK_MS = 15000;
		/* 与 Astro 前端里的字形表一致。 */
		const SEG = [
			"abcdef",
			"bc",
			"abdeg",
			"abcdg",
			"bcfg",
			"acdfg",
			"acdefg",
			"abc",
			"abcdefg",
			"abcdfg",
		];
		const UNIT_ORDER: Unit[] = ["s", "h", "m"];
		const UNIT_LABEL: Record<Unit, string> = { h: "时", m: "分", s: "秒" };
		const UNIT_DIGITS: Record<Unit, number[]> = {
			h: [0, 1],
			m: [2, 3],
			s: [4, 5],
		};
		const UNIT_SECONDS: Record<Unit, number> = { h: 3600, m: 60, s: 1 };
		const PHASE_LABEL: Record<Phase, string> = {
			IDLE: "待机 IDLE",
			RUNNING: "运行 RUNNING",
			PAUSED: "暂停 PAUSED",
			DONE: "完成 DONE",
		};

		const pad2 = (value: number) =>
			String(Math.max(0, Math.min(99, Math.trunc(value)))).padStart(2, "0");

		class ShutterWirePanel extends HTMLElement {
			controller?: AbortController;
			phase: Phase = "IDLE";
			remainingTicks = DEFAULT_SECONDS * TICKS_PER_SECOND;
			presetTicks = DEFAULT_SECONDS * TICKS_PER_SECOND;
			selected: Unit = "s";
			runTicks = 0;
			runStart = 0;
			blanked = false;
			blankTimer = 0;
			loop = 0;
			lastPaint = 0;
			inputs: Record<InputKey, InputSlot> = {
				"1": { position: false, stable: false, candidate: false, timer: 0 },
				"2": { position: false, stable: false, candidate: false, timer: 0 },
				"3": { position: false, stable: false, candidate: false, timer: 0 },
				"7": { position: false, stable: false, candidate: false, timer: 0 },
			} satisfies Record<InputKey, InputSlot>;
			cache: Record<string, string> = {};
			segmentCache: string[] = ["", "", "", "", "", ""];

			get el() {
				return {
					panel: this,
					digits: this.querySelector<HTMLElement>("[data-sw-digits]"),
					digitNodes: [
						...this.querySelectorAll<HTMLElement>("[data-sw-digit]"),
					],
					phase: this.querySelector<HTMLElement>("[data-sw-phase]"),
					remain: this.querySelector<HTMLElement>("[data-sw-remain]"),
					out1: this.querySelector<HTMLElement>("[data-sw-out1]"),
					out2: this.querySelector<HTMLElement>("[data-sw-out2]"),
					unit: this.querySelector<HTMLElement>("[data-sw-unit]"),
					note: this.querySelector<HTMLElement>("[data-sw-note]"),
					shutter: this.querySelector<HTMLElement>("[data-sw-shutter]"),
					power: this.querySelector<HTMLElement>("[data-sw-power]"),
				};
			}

			connectedCallback() {
				if (this.querySelector("[data-sw-digits]") === null) return;
				this.controller = new AbortController();
				const { signal } = this.controller;

				const toggleButtons = [
					...this.querySelectorAll<HTMLElement>("[data-sw-toggle]"),
				];
				for (const button of toggleButtons) {
					const key = button.dataset.swToggle as InputKey;
					button.addEventListener("click", () => this.operateSwitch(key), {
						signal,
					});
					const slot = this.inputs[key];
					slot.position = button.getAttribute("aria-checked") === "true";
					slot.stable = slot.position;
					slot.candidate = slot.position;
				}

				const shutter = this.el.shutter;
				if (shutter) {
					this.inputs["7"].position =
						shutter.getAttribute("aria-pressed") === "true";
					this.inputs["7"].stable = this.inputs["7"].position;
					this.inputs["7"].candidate = this.inputs["7"].position;
					shutter.addEventListener("click", () => this.operateSwitch("7"), {
						signal,
					});
				}

				const keyButton = (index: string) =>
					this.querySelector<HTMLElement>(`[data-sw-key="${index}"]`);

				const plus = keyButton("4");
				const minus = keyButton("6");
				const confirm = keyButton("5");
				if (plus) this.bindRepeater(plus, () => this.stepTime(1));
				if (minus) this.bindRepeater(minus, () => this.stepTime(-1));
				if (confirm) this.bindConfirm(confirm);
				this.el.power?.addEventListener("click", () => this.powerOn(), {
					signal,
				});

				this.paint();
				this.scheduleBlank();
			}

			disconnectedCallback() {
				this.controller?.abort();
				window.clearTimeout(this.blankTimer);
				for (const key of ["1", "2", "3", "7"] as InputKey[])
					window.clearTimeout(this.inputs[key].timer);
				if (this.loop) cancelAnimationFrame(this.loop);
				this.loop = 0;
			}

			/* ── 输入 ─────────────────────────────────────── */
			operateSwitch(key: InputKey) {
				this.wake();
				const slot = this.inputs[key];
				slot.position = !slot.position;
				slot.candidate = slot.position;
				this.paint();
				window.clearTimeout(slot.timer);
				slot.timer = window.setTimeout(
					() => this.settleInput(key),
					DEBOUNCE_MS,
				);
			}

			settleInput(key: InputKey) {
				const slot = this.inputs[key];
				if (slot.candidate === slot.stable) {
					this.setNote("电平回到原值：按反跳处理，不产生新操作。");
					return;
				}
				slot.stable = slot.candidate;
				if (key === "7") this.edgeOnK7();
				else this.checkPermit();
				this.paint();
			}

			permit() {
				return (
					this.inputs["1"].stable &&
					this.inputs["2"].stable &&
					this.inputs["3"].stable
				);
			}

			checkPermit() {
				const state = (["1", "2", "3"] as InputKey[])
					.map((key) => `K${key}${this.inputs[key].stable ? "闭合" : "断开"}`)
					.join("、");
				if (this.phase === "RUNNING" && !this.permit()) {
					this.pause();
					this.setNote(
						`${state}：许可失效，运行 → 暂停，余量 ${this.remainingTicks} tick 保留。`,
					);
					return;
				}
				this.setNote(`${state}：消抖 31.25 ms 后确认。`);
			}

			edgeOnK7() {
				if (!this.permit()) {
					this.setNote(
						"许可条件未满足：这次 K7 操作被消耗，不留给之后补触发。",
					);
					return;
				}
				if (this.phase === "IDLE") {
					this.startRun(this.presetTicks);
					this.setNote("K7 操作：待机 → 运行，IN1–OUT1 接通并开始扣减余量。");
					return;
				}
				if (this.phase === "RUNNING") {
					this.pause();
					this.setNote(
						`K7 操作：运行 → 暂停，余量 ${this.remainingTicks} tick（${(
							this.remainingTicks / TICKS_PER_SECOND
						).toFixed(3)} s）保留。`,
					);
					return;
				}
				if (this.phase === "PAUSED") {
					this.startRun(this.remainingTicks);
					this.setNote("K7 操作：暂停 → 运行，从保存的余量继续扣减。");
					return;
				}
				this.startRun(this.presetTicks);
				this.setNote("K7 操作：完成 → 运行，重新从设定值开始。");
			}

			/* ── 调时 ─────────────────────────────────────── */
			settingAllowed() {
				return this.phase === "IDLE" || this.phase === "DONE";
			}

			tapConfirm() {
				this.wake();
				if (!this.settingAllowed()) {
					this.setNote("运行和暂停期间不响应切换单位；长按 K5 两秒可退出暂停。");
					return;
				}
				if (this.phase === "DONE") this.backToIdle();
				this.selected =
					UNIT_ORDER[(UNIT_ORDER.indexOf(this.selected) + 1) % UNIT_ORDER.length];
				this.setNote(`K5 确认：选中单位切换到「${UNIT_LABEL[this.selected]}」。`);
				this.paint();
			}

			holdConfirm() {
				this.wake();
				if (this.phase === "PAUSED" || this.phase === "DONE") {
					this.backToIdle();
					this.setNote("长按 K5 两秒：回到待机，保留设定值。");
					this.paint();
					return;
				}
				this.setNote("长按 K5 两秒只在暂停或完成后退出，当前状态无需退出。");
			}

			stepTime(direction: 1 | -1) {
				this.wake();
				if (!this.settingAllowed()) {
					this.setNote("运行和暂停期间禁用加减，避免改写正在使用的余量。");
					return;
				}
				if (this.phase === "DONE") this.backToIdle();
				const step = UNIT_SECONDS[this.selected] * direction;
				const current = Math.round(this.presetTicks / TICKS_PER_SECOND);
				const next = Math.min(
					MAX_SECONDS,
					Math.max(MIN_SECONDS, current + step),
				);
				this.presetTicks = next * TICKS_PER_SECOND;
				this.setNote(
					`K${direction > 0 ? "4 加" : "6 减"}${UNIT_LABEL[this.selected]}：设定 ${this.formatTime(next)}。`,
				);
				this.paint();
			}

			backToIdle() {
				this.phase = "IDLE";
				this.remainingTicks = this.presetTicks;
				this.scheduleBlank();
			}

			/* ── 运行、暂停、完成 ─────────────────────────── */
			startRun(ticks: number) {
				this.phase = "RUNNING";
				this.runTicks = Math.max(1, ticks);
				this.remainingTicks = this.runTicks;
				this.runStart = performance.now();
				this.blanked = false;
				window.clearTimeout(this.blankTimer);
				this.startLoop();
				this.paint();
			}

			pause() {
				this.remainingTicks = this.currentRemaining();
				this.phase = "PAUSED";
				this.stopLoop();
				this.scheduleBlank();
				this.paint();
			}

			currentRemaining() {
				if (this.phase !== "RUNNING") return this.remainingTicks;
				const consumed = Math.floor((performance.now() - this.runStart) / TICK_MS);
				return Math.max(0, this.runTicks - consumed);
			}

			startLoop() {
				if (this.loop) return;
				this.lastPaint = 0;
				this.loop = requestAnimationFrame(() => this.tick());
			}

			stopLoop() {
				if (this.loop) cancelAnimationFrame(this.loop);
				this.loop = 0;
			}

			tick() {
				this.loop = 0;
				if (this.phase !== "RUNNING") return;
				const remaining = this.currentRemaining();
				if (remaining <= 0) {
					this.phase = "DONE";
					this.remainingTicks = 0;
					this.blanked = false;
					this.setNote("到时：IN1–OUT1 断开，数码管显示 0，等待下一次 K7 操作。");
					this.scheduleBlank();
					this.paint();
					return;
				}
				const now = performance.now();
				if (now - this.lastPaint >= 50) this.paint();
				this.loop = requestAnimationFrame(() => this.tick());
			}

			/* ── 上电与熄屏 ───────────────────────────────── */
			powerOn() {
				this.stopLoop();
				window.clearTimeout(this.blankTimer);
				for (const key of ["1", "2", "3", "7"] as InputKey[])
					window.clearTimeout(this.inputs[key].timer);
				for (const key of ["1", "2", "3", "7"] as InputKey[]) {
					const slot = this.inputs[key];
					slot.candidate = slot.position;
					slot.stable = slot.position;
				}
				this.phase = "IDLE";
				this.remainingTicks = this.presetTicks;
				this.selected = "s";
				this.blanked = false;
				this.setNote(
					this.inputs["7"].position
						? "重新上电：各开关保持物理位置，K7 的电平不作为新边沿，因此不会自动接通快门。"
						: "重新上电：各开关保持物理位置，K7 弹起，设定 10 秒。",
				);
				this.scheduleBlank();
				this.paint();
			}

			wake() {
				if (this.blanked) {
					this.blanked = false;
					this.setNote("操作唤醒：数码管与指示灯重新点亮。");
				}
				this.scheduleBlank();
			}

			scheduleBlank() {
				window.clearTimeout(this.blankTimer);
				this.blankTimer = 0;
				if (this.phase === "RUNNING") return;
				this.blankTimer = window.setTimeout(() => {
					this.blanked = true;
					this.setNote("15 s 无操作：数码管与四个指示灯一起熄灭，再次操作唤醒。");
					this.paint();
				}, BLANK_MS);
			}

			/* ── 按键手势 ─────────────────────────────────── */
			bindRepeater(element: HTMLElement, step: () => void) {
				const { signal } = this.controller!;
				let delay = 0;
				let interval = 0;
				const stop = () => {
					window.clearTimeout(delay);
					window.clearInterval(interval);
					delay = 0;
					interval = 0;
					element.classList.remove("is-down");
				};
				const start = () => {
					stop();
					element.classList.add("is-down");
					window.setTimeout(step, DEBOUNCE_MS);
					delay = window.setTimeout(() => {
						interval = window.setInterval(step, REPEAT_INTERVAL_MS);
					}, REPEAT_DELAY_MS);
				};
				element.addEventListener("pointerdown", start, { signal });
				for (const type of ["pointerup", "pointercancel", "pointerleave"])
					element.addEventListener(type, stop, { signal });
				element.addEventListener(
					"keydown",
					(event) => {
						if (event.key !== "Enter" && event.key !== " ") return;
						event.preventDefault();
						if (!event.repeat) start();
					},
					{ signal },
				);
				element.addEventListener(
					"keyup",
					(event) => {
						if (event.key === "Enter" || event.key === " ") stop();
					},
					{ signal },
				);
				element.addEventListener("blur", stop, { signal });
			}

			bindConfirm(element: HTMLElement) {
				const { signal } = this.controller!;
				let hold = 0;
				let long = false;
				const stop = () => {
					window.clearTimeout(hold);
					hold = 0;
					element.classList.remove("is-down");
				};
				const start = () => {
					stop();
					element.classList.add("is-down");
					long = false;
					hold = window.setTimeout(() => {
						long = true;
						this.holdConfirm();
					}, LONG_PRESS_MS);
				};
				const end = () => {
					const wasLong = long;
					stop();
					if (!wasLong) this.tapConfirm();
				};
				element.addEventListener("pointerdown", start, { signal });
				element.addEventListener("pointerup", end, { signal });
				for (const type of ["pointercancel", "pointerleave"])
					element.addEventListener(type, stop, { signal });
				element.addEventListener(
					"keydown",
					(event) => {
						if (event.key !== "Enter" && event.key !== " ") return;
						event.preventDefault();
						if (!event.repeat) start();
					},
					{ signal },
				);
				element.addEventListener(
					"keyup",
					(event) => {
						if (event.key === "Enter" || event.key === " ") end();
					},
					{ signal },
				);
				element.addEventListener("blur", stop, { signal });
			}

			/* ── 显示 ─────────────────────────────────────── */
			formatTime(totalSeconds: number) {
				const hours = Math.floor(totalSeconds / 3600);
				const minutes = Math.floor((totalSeconds % 3600) / 60);
				const seconds = totalSeconds % 60;
				return `${pad2(hours)}:${pad2(minutes)}:${pad2(seconds)}`;
			}

			displaySeconds() {
				if (this.phase === "DONE") return 0;
				if (this.phase === "IDLE") return Math.ceil(this.presetTicks / TICKS_PER_SECOND);
				return Math.ceil(this.currentRemaining() / TICKS_PER_SECOND);
			}

			blinkDigits() {
				if (this.blanked) return [];
				if (this.phase === "PAUSED") return [0, 1, 2, 3, 4, 5];
				if (this.phase === "IDLE") return UNIT_DIGITS[this.selected];
				return [];
			}

			setText(key: string, node: Element | null, value: string) {
				if (!node || this.cache[key] === value) return;
				this.cache[key] = value;
				node.textContent = value;
			}

			setState(
				key: string,
				node: Element | null,
				name: string,
				active: boolean,
			) {
				if (!node) return;
				const stamp = `${name}:${active}`;
				if (this.cache[key] === stamp) return;
				this.cache[key] = stamp;
				node.classList.toggle(name, active);
			}

			setNote(message: string) {
				this.setText("note", this.el.note, message);
			}

			paint() {
				const nodes = this.el;
				const remaining = this.currentRemaining();
				const seconds = this.displaySeconds();

				/* 数码管 */
				if (this.cache["blank"] !== String(this.blanked)) {
					this.cache["blank"] = String(this.blanked);
					this.segmentCache = ["", "", "", "", "", ""];
				}
				const text = `${pad2(Math.floor(seconds / 3600))}${pad2(
					Math.floor((seconds % 3600) / 60),
				)}${pad2(seconds % 60)}`;
				const blink = this.blinkDigits();
				nodes.digitNodes.forEach((digit, index) => {
					const char = text[index];
					if (this.segmentCache[index] !== char) {
						this.segmentCache[index] = char;
						const on = SEG[Number(char)] ?? "";
						for (const element of digit.children) {
							const segment = element.className.match(/sw-seg-([a-g])/)?.[1];
							element.classList.toggle(
								"is-on",
								!this.blanked && Boolean(segment) && on.includes(segment!),
							);
						}
					}
					this.setState(
						`digit${index}`,
						digit,
						"is-blinking",
						blink.includes(index),
					);
				});
				this.setState("blanked", nodes.digits, "is-blanked", this.blanked);

				/* 指示灯：绿＝对应接点闭合，红＝未闭合 */
				for (const key of ["1", "2", "3", "7"] as InputKey[]) {
					const led = this.querySelector<HTMLElement>(`[data-sw-led="${key}"]`);
					const closed = this.inputs[key].position;
					this.setState(`led-off-${key}`, led, "is-off", this.blanked);
					this.setState(
						`led-green-${key}`,
						led,
						"is-green",
						!this.blanked && closed,
					);
					this.setState(`led-red-${key}`, led, "is-red", !this.blanked && !closed);
				}

				/* 控件位置 */
				for (const key of ["1", "2", "3"] as InputKey[]) {
					const button = this.querySelector<HTMLElement>(
						`[data-sw-toggle="${key}"]`,
					);
					const value = String(this.inputs[key].position);
					if (button && button.getAttribute("aria-checked") !== value)
						button.setAttribute("aria-checked", value);
				}
				if (
					nodes.shutter &&
					nodes.shutter.getAttribute("aria-pressed") !==
						String(this.inputs["7"].position)
				)
					nodes.shutter.setAttribute(
						"aria-pressed",
						String(this.inputs["7"].position),
					);

				/* 读数 */
				const closed = (key: InputKey) => this.inputs[key].stable;
				this.setText("phase", nodes.phase, PHASE_LABEL[this.phase]);
				this.setText(
					"remain",
					nodes.remain,
					`${Math.round(remaining)} tick · ${(remaining / TICKS_PER_SECOND).toFixed(3)} s`,
				);
				this.setText(
					"out1",
					nodes.out1,
					this.phase === "RUNNING" ? "接通" : "断开",
				);
				this.setText("out2", nodes.out2, closed("1") ? "接通" : "断开");
				this.setText(
					"unit",
					nodes.unit,
					this.settingAllowed()
						? `选中 ${UNIT_LABEL[this.selected]}`
						: "调时禁用",
				);
				this.lastPaint = performance.now();
			}
		}

		if (!customElements.get("shutter-wire-panel"))
			customElements.define("shutter-wire-panel", ShutterWirePanel);

		class ShutterWirePage extends HTMLElement {
			controller?: AbortController;
			observer?: IntersectionObserver;
			timers: number[] = [];
			frame = 0;

			connectedCallback() {
				const chapters = [
					...this.querySelectorAll<HTMLElement>("[data-sw-chapter]"),
				];
				if (!chapters.length) return;
				this.controller = new AbortController();
				const { signal } = this.controller;
				const reduced = window.matchMedia("(prefers-reduced-motion: reduce)")
					.matches;

				/* 逐章出场：先全部可见，再叠加一次短促错峰，不把阅读交给滚动位置。 */
				if (!reduced) {
					for (const chapter of chapters) chapter.classList.add("is-pending");
					requestAnimationFrame(() => {
						chapters.forEach((chapter, index) => {
							this.timers.push(
								window.setTimeout(
									() => {
										chapter.classList.remove("is-pending");
										chapter.classList.add("is-revealed");
									},
									Math.min(index * 45, 360),
								),
							);
						});
					});
				}

				/* 探针与目录高亮：只看当前进入视口的章节。 */
				this.setCurrent(chapters[0]);
				if ("IntersectionObserver" in window) {
					this.observer = new IntersectionObserver(
						(entries) => {
							const visible = entries
								.filter((entry) => entry.isIntersecting)
								.sort(
									(a, b) =>
										a.boundingClientRect.top - b.boundingClientRect.top,
								)[0];
							if (visible) this.setCurrent(visible.target as HTMLElement);
						},
						{ rootMargin: "-15% 0px -55% 0px", threshold: 0 },
					);
					for (const chapter of chapters) this.observer.observe(chapter);
				}

				/* 窄屏把目录折起，避免正文被长目录推到很下面。 */
				if (window.matchMedia("(max-width: 1080px)").matches) {
					this.querySelector<HTMLDetailsElement>(".sw-toc details")?.removeAttribute(
						"open",
					);
				}

				const refresh = () => this.setCurrent(this.currentChapter());
				document.addEventListener("article:content-ready", refresh, { signal });
				window.addEventListener(
					"resize",
					() => {
						cancelAnimationFrame(this.frame);
						this.frame = requestAnimationFrame(refresh);
					},
					{ passive: true, signal },
				);
			}

			disconnectedCallback() {
				this.controller?.abort();
				this.observer?.disconnect();
				for (const timer of this.timers) window.clearTimeout(timer);
				this.timers = [];
				cancelAnimationFrame(this.frame);
			}

			currentChapter() {
				const chapters = [
					...this.querySelectorAll<HTMLElement>("[data-sw-chapter]"),
				];
				let found = chapters[0];
				for (const chapter of chapters) {
					if (chapter.getBoundingClientRect().top <= window.innerHeight * 0.4)
						found = chapter;
				}
				return found;
			}

			setCurrent(chapter?: HTMLElement) {
				if (!chapter) return;
				for (const item of this.querySelectorAll<HTMLElement>(
					"[data-sw-chapter]",
				))
					item.classList.toggle("is-current", item === chapter);
				const id = chapter.dataset.swHeading || "";
				for (const link of this.querySelectorAll<HTMLAnchorElement>(
					".sw-toc a[href^='#']",
				)) {
					const match = decodeURIComponent(link.hash.slice(1)) === id && id !== "";
					link.classList.toggle("is-current", match);
					if (match) link.setAttribute("aria-current", "true");
					else link.removeAttribute("aria-current");
				}
			}
		}

		if (!customElements.get("shutter-wire-page"))
			customElements.define("shutter-wire-page", ShutterWirePage);
	</script>
</PageShell>
