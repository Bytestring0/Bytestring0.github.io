	<script>
		interface Chapter extends HTMLElement {
			dataset: DOMStringMap & { staChapter?: string };
		}

		class StaWorkbench extends HTMLElement {
			controller?: AbortController;
			observer?: IntersectionObserver;
			railObserver?: IntersectionObserver;
			frame = 0;
			revealTimers: number[] = [];
			chapters: HTMLElement[] = [];

			connectedCallback() {
				if (this.querySelector("[data-sta-chapter]") === null) return;
				this.controller = new AbortController();
				const { signal } = this.controller;

				const reduced = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches;

				this.chapters = [
					...this.querySelectorAll<HTMLElement>("[data-sta-chapter]"),
				];

				/* 1. entrance reveal.
				   Every chapter is revealed on load with a short stagger, so motion
				   exists without ever gating readability on scroll position. */
				for (const chapter of this.chapters) chapter.classList.add("is-pending");
				requestAnimationFrame(() => {
					this.chapters.forEach((chapter, index) => {
						this.revealTimers.push(
							window.setTimeout(
								() => {
									chapter.classList.remove("is-pending");
									chapter.classList.add("is-revealed");
								},
								Math.min(index * 70, 420),
							),
						);
					});
				});

				/* 2. rail highlight + progress fill */
				this.setActive(0);
				const railItems = [
					...this.querySelectorAll<HTMLElement>("[data-sta-rail-item]"),
				];
				if ("IntersectionObserver" in window && railItems.length) {
					this.railObserver = new IntersectionObserver(
						(entries) => {
							const visible = entries
								.filter((entry) => entry.isIntersecting)
								.sort(
									(a, b) =>
										a.boundingClientRect.top -
										b.boundingClientRect.top,
								)[0];
							if (visible)
								this.setActive(Number(visible.target.getAttribute("data-sta-chapter")) || 0);
						},
						{ rootMargin: "-20% 0px -60% 0px", threshold: 0 },
					);
					for (const chapter of this.chapters)
						this.railObserver.observe(chapter);
				}

				/* 3. build the model-selection matrix out of the real table */
				this.buildSelectionMatrix();

				/* 4. progress fill follows scroll */
				const onScroll = () => {
					cancelAnimationFrame(this.frame);
					this.frame = requestAnimationFrame(() => this.updateRail());
				};
				window.addEventListener("scroll", onScroll, {
					passive: true,
					signal,
				});
				window.addEventListener("resize", onScroll, {
					passive: true,
					signal,
				});
				this.updateRail();
			}

			setActive(index: number) {
				for (const item of this.querySelectorAll<HTMLElement>(
					"[data-sta-rail-item]",
				)) {
					item.classList.toggle(
						"is-active",
						Number(item.getAttribute("data-sta-rail-item")) === index,
					);
				}
			}

			updateRail() {
				const rail = this.querySelector<HTMLElement>(".sta-rail");
				const fill = this.querySelector<HTMLElement>("[data-sta-rail-fill]");
				if (!rail || !fill) return;
				const box = rail.getBoundingClientRect();
				const total = Math.max(window.innerHeight - box.top - 120, 1);
				const first = this.chapters[0];
				const last = this.chapters[this.chapters.length - 1];
				if (!first || !last) return;
				const start = first.getBoundingClientRect().top - box.top;
				const end = last.getBoundingClientRect().bottom - box.top;
				const progress = (window.innerHeight * 0.5 - box.top - start) / Math.max(end - start, 1);
				fill.style.height = `${Math.min(Math.max(progress, 0), 1) * 100}%`;
				void total;
			}

			/* Turn the "怎么选模型？" table into a pickable matrix:
			   an interactive control that highlights the matching real row.
			   No text is duplicated — the table remains the single source. */
			buildSelectionMatrix() {
				const tables = this.querySelectorAll<HTMLTableElement>(
					".sta-chapter-body table",
				);
				if (!tables.length) return;
				// The selection table is the one whose first column says 应用场景.
				let target: HTMLTableElement | undefined;
				for (const table of tables) {
					const head = table.querySelector("thead")?.textContent ?? "";
					if (head.includes("应用场景") && head.includes("推荐模型")) {
						target = table;
						break;
					}
				}
				if (!target) return;
				const body = target.querySelector("tbody");
				if (!body) return;
				const rows = [...body.querySelectorAll<HTMLTableRowElement>("tr")];
				if (rows.length < 2) return;

				const panel = document.createElement("div");
				panel.className = "sta-matrix";
				panel.setAttribute("role", "group");
				panel.setAttribute("aria-label", "选型快捷切换");
				const caption = document.createElement("p");
				caption.className = "sta-matrix-title";
				caption.textContent = "选型矩阵 · 点选你的场景";
				panel.append(caption);

				const buttons = document.createElement("div");
				buttons.className = "sta-matrix-keys";

				rows.forEach((row, index) => {
					const scene = row.cells[0]?.textContent?.trim() ?? "";
					const pick = row.cells[1]?.textContent?.trim() ?? "";
					if (!scene) return;
					const button = document.createElement("button");
					button.type = "button";
					button.className = "sta-key";
					button.setAttribute("data-sta-key", String(index));
					const label = document.createElement("span");
					label.className = "sta-key-scene";
					label.textContent = scene;
					const hint = document.createElement("span");
					hint.className = "sta-key-pick";
					hint.textContent = pick;
					button.append(label, hint);
					button.addEventListener("click", () => {
						const on = row.classList.toggle("is-picked");
						button.classList.toggle("is-picked", on);
						if (on) {
							const box = row.getBoundingClientRect();
							const off =
								box.top < 90 || box.bottom > window.innerHeight - 40;
							if (off)
								row.scrollIntoView({
									block: "center",
									behavior: window.matchMedia(
										"(prefers-reduced-motion: reduce)",
									).matches
										? "auto"
										: "smooth",
								});
						}
					});
					buttons.append(button);
				});

				panel.append(buttons);
				const notice = document.createElement("p");
				notice.className = "sta-matrix-note";
				notice.textContent =
					"选中会在下方对照表中高亮对应行；表格内容保持原文不变。";
				panel.append(notice);

				// Insert *outside* the source block so the original block's text,
				// children and protected elements stay untouched.
				const host = target.closest("[data-source-block]") ?? target;
				host.parentElement?.insertBefore(panel, host);

				const style = document.createElement("style");
				style.textContent = `
					.sta-matrix{margin:1.25rem 0 0;}
					.sta-matrix-title{font-family:var(--sta-mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--sta-ink-faint);margin:0 0 .6rem;}
					.sta-matrix-keys{display:flex;flex-wrap:wrap;gap:.5rem;}
					.sta-key{display:flex;flex-direction:column;align-items:flex-start;gap:.15rem;padding:.5rem .7rem;border:1px solid var(--sta-hair);border-radius:8px;background:var(--sta-panel);color:inherit;font:inherit;font-size:.78rem;line-height:1.4;cursor:pointer;text-align:left;transition:border-color .2s ease,background .2s ease,transform .2s ease;}
					.sta-key:hover{border-color:var(--sta-tint-strong);transform:translateY(-1px);}
					.sta-key:focus-visible{outline:2px solid var(--primary);outline-offset:2px;}
					.sta-key.is-picked{border-color:var(--primary);background:var(--sta-tint-strong);}
					.sta-key-scene{font-weight:650;}
					.sta-key-pick{font-family:var(--sta-mono);font-size:.68rem;color:var(--sta-ink-faint);}
					.sta-key.is-picked .sta-key-pick{color:var(--primary);}
					.sta-matrix-note{margin:.7rem 0 0;font-size:.72rem;color:var(--sta-ink-faint);}
				`;
				this.append(style);
			}

			disconnectedCallback() {
				this.observer?.disconnect();
				this.railObserver?.disconnect();
				this.controller?.abort();
				cancelAnimationFrame(this.frame);
				window.clearTimeout(this.revealTimer);
				this.revealTimers.forEach((timer) => window.clearTimeout(timer));
			}
		}

		if (!customElements.get("sta-workbench"))
			customElements.define("sta-workbench", StaWorkbench);
	</script>
</PageShell>
