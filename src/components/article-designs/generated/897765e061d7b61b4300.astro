---
import type { CollectionEntry } from "astro:content";
import {
	groupArticleBlocks,
	type ArticleSource,
} from "../../../utils/article-source";
import SourceBlock from "../SourceBlock.astro";
import PageShell from "../PageShell.astro";
import PageNavigation from "../PageNavigation.astro";
import PageTOC from "../PageTOC.astro";
import PageComments from "../PageComments.astro";
import PageFooter from "../PageFooter.astro";
import PagePagination from "../PagePagination.astro";
import ArticleContent from "../ArticleContent.astro";
import ExperienceFooter from "../ExperienceFooter.astro";
import PostMeta from "../../PostMeta.astro";

interface Props {
	entry: CollectionEntry<"posts">;
	article: ArticleSource;
	designKey: string;
}
const { entry, article, designKey } = Astro.props;

// Group by original h2 so each chapter is one section.
const groups = groupArticleBlocks(article, 2);

// Chapter labels are purely presentational (printed in the section rail).
// They never duplicate block text; the real headings stay inside the blocks.
// The first group is the untitled intro (blocks before the first h2), so the
// labels are offset by one relative to the h2 chapters.
const railLabels = [
	"引言",
	"总体框架",
	"Cell 时序模型",
	"互连模型",
	"Ceff 桥梁",
	"怎么选模型",
	"核心结论",
];
---

<PageShell entry={entry} designKey={designKey} class="sta-page">
	<PageNavigation class="sta-nav" />

	<sta-workbench class="sta-workbench">
	<!-- ── Header: instrument panel ───────────────────────────── -->
	<header class="sta-hero">
		<div class="sta-hero-inner">
			<div class="sta-hero-main">
				<p class="sta-kicker">
					<span class="sta-led" aria-hidden="true"></span>
					STATIC TIMING ANALYSIS · MODEL SURVEY
				</p>
				<h1 data-pagefind-meta="title" data-pagefind-body data-pagefind-weight="10">
					{entry.data.title}
				</h1>
				<PostMeta
					className="sta-meta"
					published={entry.data.published}
					updated={entry.data.updated}
					tags={entry.data.tags}
					category={entry.data.category || undefined}
					id={entry.id}
				/>
			</div>

			<!-- Decorative scope: a rising waveform with markers -->
			<div class="sta-scope" aria-hidden="true">
				<span class="sta-scope-label">SCOPE</span>
				<svg viewBox="0 0 320 96" preserveAspectRatio="none">
					<defs>
						<linearGradient id="stafill" x1="0" y1="1" x2="0" y2="0">
							<stop offset="0%" stop-color="var(--primary)" stop-opacity="0"></stop>
							<stop offset="100%" stop-color="var(--primary)" stop-opacity="0.28"></stop>
						</linearGradient>
					</defs>
					<g class="sta-scope-grid">
						<line x1="0" y1="24" x2="320" y2="24"></line>
						<line x1="0" y1="48" x2="320" y2="48"></line>
						<line x1="0" y1="72" x2="320" y2="72"></line>
						<line x1="80" y1="0" x2="80" y2="96"></line>
						<line x1="160" y1="0" x2="160" y2="96"></line>
						<line x1="240" y1="0" x2="240" y2="96"></line>
					</g>
					<path
						class="sta-scope-area"
						d="M0,96 L0,88 C40,88 56,84 76,60 C96,36 112,20 160,16 C208,12 240,26 320,34 L320,96 Z"
						fill="url(#stafill)"
					></path>
					<path
						class="sta-scope-trace"
						d="M0,88 C40,88 56,84 76,60 C96,36 112,20 160,16 C208,12 240,26 320,34"
					></path>
					<line class="sta-scope-marker" x1="160" y1="0" x2="160" y2="96"></line>
				</svg>
				<div class="sta-scope-readout">
					<span>t<sub>50%</sub></span>
					<span class="sta-scope-val">0.69·R<sub>eq</sub>C<sub>L</sub></span>
				</div>
			</div>
		</div>

		<!-- AI 导读：marked, visually weaker than the article body -->
		<aside class="sta-primer" aria-label="AI 导读">
			<p class="sta-primer-tag">AI 导读</p>
			<p>
				这篇笔记回答一个问题：STA 报告上那个延迟数字，是怎么算出来的。全文分两层——
				先看<strong>标准单元</strong>怎么被建模（Linear → PWL → NLDM → CCS → ECSM，
				本质是"用一个标量描述波形"到"直接描述波形"的进化），再看<strong>互连线</strong>怎么被建模
				（Lumped C → Elmore → D2M → AWE/PRIMA，本质是"用几个矩去逼近阶跃响应"）。
			</p>
			<p>
				中间那座桥是 C<sub>eff</sub>：它把分布 RC 网络折算成一个电容，好让只会查表的 NLDM
				也能处理真实互连。最后一张选型表给出不同精度预算下的选择。每节都带公式来源，
				看到公式卡住时，回去看上一节的假设在哪里被打破。
			</p>
		</aside>
	</header>

	<!-- ── Workbench body ─────────────────────────────────────── -->
	<div class="sta-body">
		<div class="sta-layout">
			<!-- Section rail: index spine + scroll progress -->
			<nav class="sta-rail" aria-hidden="true">
				<div class="sta-rail-track">
					<span class="sta-rail-fill" data-sta-rail-fill></span>
				</div>
				<ol class="sta-rail-list">
					{
						groups.map((_, index) => (
							<li
								class="sta-rail-item"
								data-sta-rail-item={index}
							>
								<span class="sta-rail-num">
									{String(index + 1).padStart(2, "0")}
								</span>
								<span class="sta-rail-label">
									{railLabels[index] ?? ""}
								</span>
							</li>
						))
					}
				</ol>
			</nav>

			<ArticleContent entry={entry} article={article} class="sta-content">
				<div class="sta-chapters" data-pagefind-body>
					{
						groups.map((blocks, index) => (
							<section
								class="sta-chapter"
								data-sta-chapter={index}
								data-sta-chapter-name={railLabels[index] ?? ""}
							>
								<div class="sta-chapter-head">
									<span class="sta-chapter-num">
										{String(index + 1).padStart(2, "0")}
									</span>
									<span class="sta-chapter-line" />
									<span class="sta-chapter-text">
										{railLabels[index] ?? ""}
									</span>
								</div>
								<div class="sta-chapter-body">
									{blocks.map((block) => (
										<SourceBlock block={block} prose={false} />
									))}
								</div>
							</section>
						))
					}
				</div>
				<ExperienceFooter entry={entry} />
			</ArticleContent>

			<aside class="sta-side">
				<div class="sta-side-sticky">
					<PageTOC label="本章目录" class="sta-toc" />
					<div class="sta-legend" aria-hidden="true">
						<p class="sta-legend-title">读图约定</p>
						<ul>
							<li>
								<span class="sta-chip sta-chip-cell">CELL</span>
								标准单元模型
							</li>
							<li>
								<span class="sta-chip sta-chip-net">NET</span>
								互连网络模型
							</li>
							<li>
								<span class="sta-chip sta-chip-formula">ƒ</span>
								带推导的公式
							</li>
						</ul>
					</div>
				</div>
			</aside>
		</div>

		<PageComments entry={entry} class="sta-comments" />
		<PagePagination entry={entry} class="sta-pagination" />
	</div>

	<PageFooter />
	</sta-workbench>

	<style is:inline>
		/* ── tokens ─────────────────────────────────────────── */
		[data-article-design="897765e061d7b61b4300"] {
			--sta-mono: ui-monospace, "SFMono-Regular", "Cascadia Mono", Consolas,
				monospace;
			--sta-hair: var(--line-divider, rgba(128, 128, 128, 0.24));
			--sta-panel: var(--card-bg, rgba(127, 127, 127, 0.06));
			--sta-tint: color-mix(in srgb, var(--primary) 10%, transparent);
			--sta-tint-strong: color-mix(in srgb, var(--primary) 22%, transparent);
			--sta-ink: color-mix(in srgb, currentColor 100%, transparent);
			--sta-ink-soft: color-mix(in srgb, currentColor 62%, transparent);
			--sta-ink-faint: color-mix(in srgb, currentColor 38%, transparent);
		}

		[data-article-design="897765e061d7b61b4300"] .sta-workbench {
			display: block;
		}

		[data-article-design="897765e061d7b61b4300"] .sta-nav {
			position: sticky;
			top: 0;
			z-index: 60;
			background: color-mix(in srgb, var(--card-bg) 88%, transparent);
			backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--sta-hair);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-nav #navbar > div:last-child {
			max-width: none;
		}

		/* ── hero ───────────────────────────────────────────── */
		[data-article-design="897765e061d7b61b4300"] .sta-hero {
			width: min(calc(100% - 3rem), 84rem);
			margin: clamp(1.5rem, 4vw, 3.5rem) auto 0;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-hero-inner {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
			gap: clamp(1.5rem, 4vw, 3rem);
			align-items: end;
			padding-bottom: 1.75rem;
			border-bottom: 1px solid var(--sta-hair);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-kicker {
			display: flex;
			align-items: center;
			gap: 0.55rem;
			font-family: var(--sta-mono);
			font-size: 0.7rem;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--sta-ink-faint);
			margin-bottom: 0.85rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-led {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: var(--primary);
			box-shadow: 0 0 0 3px var(--sta-tint);
			animation: sta-pulse 2.6s ease-in-out infinite;
		}
		@keyframes sta-pulse {
			0%,
			100% {
				opacity: 1;
			}
			50% {
				opacity: 0.35;
			}
		}
		[data-article-design="897765e061d7b61b4300"] .sta-hero h1 {
			font-size: clamp(2rem, 4.6vw, 3.6rem);
			line-height: 1.12;
			font-weight: 800;
			letter-spacing: -0.02em;
			margin: 0 0 1rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-meta {
			margin: 0;
		}

		/* scope panel */
		[data-article-design="897765e061d7b61b4300"] .sta-scope {
			position: relative;
			border: 1px solid var(--sta-hair);
			border-radius: 12px;
			background: var(--sta-panel);
			padding: 1.6rem 0.9rem 0.6rem;
			overflow: hidden;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope-label {
			position: absolute;
			top: 0.5rem;
			left: 0.8rem;
			font-family: var(--sta-mono);
			font-size: 0.6rem;
			letter-spacing: 0.16em;
			color: var(--sta-ink-faint);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope svg {
			display: block;
			width: 100%;
			height: 88px;
			overflow: visible;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope-grid line {
			stroke: var(--sta-hair);
			stroke-width: 0.6;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope-trace {
			fill: none;
			stroke: var(--primary);
			stroke-width: 2;
			stroke-linecap: round;
			stroke-dasharray: 460;
			stroke-dashoffset: 460;
			animation: sta-draw 2.4s 0.25s ease-out forwards;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope-area {
			opacity: 0;
			animation: sta-fade 1s 1.8s ease-out forwards;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope-marker {
			stroke: color-mix(in srgb, currentColor 30%, transparent);
			stroke-width: 1;
			stroke-dasharray: 3 4;
			opacity: 0;
			animation: sta-fade 0.6s 2.1s ease-out forwards;
		}
		@keyframes sta-draw {
			to {
				stroke-dashoffset: 0;
			}
		}
		@keyframes sta-fade {
			to {
				opacity: 1;
			}
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope-readout {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			font-family: var(--sta-mono);
			font-size: 0.68rem;
			color: var(--sta-ink-faint);
			padding: 0 0.2rem 0.15rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-scope-val {
			color: var(--primary);
			font-size: 0.72rem;
		}

		/* ── AI primer ──────────────────────────────────────── */
		[data-article-design="897765e061d7b61b4300"] .sta-primer {
			margin-top: 1.75rem;
			padding: 1.1rem 1.25rem 1.15rem;
			border: 1px dashed var(--sta-hair);
			border-left: 2px solid var(--sta-tint-strong);
			border-radius: 0 10px 10px 0;
			background: color-mix(in srgb, var(--primary) 4%, transparent);
			font-size: 0.94rem;
			line-height: 1.85;
			color: var(--sta-ink-soft);
			max-width: 62rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-primer-tag {
			display: inline-block;
			font-family: var(--sta-mono);
			font-size: 0.62rem;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--primary);
			margin: 0 0 0.6rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-primer p {
			margin: 0 0 0.7rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-primer p:last-child {
			margin-bottom: 0;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-primer strong {
			color: color-mix(in srgb, currentColor 88%, transparent);
			font-weight: 650;
		}

		/* ── layout ─────────────────────────────────────────── */
		[data-article-design="897765e061d7b61b4300"] .sta-body {
			width: min(calc(100% - 3rem), 100rem);
			margin: 0 auto clamp(2.5rem, 6vw, 5rem);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-layout {
			display: grid;
			grid-template-columns: 3rem minmax(0, 1fr) 14rem;
			gap: clamp(1rem, 1.7vw, 1.75rem);
			align-items: start;
		}

		/* ── section rail ───────────────────────────────────── */
		[data-article-design="897765e061d7b61b4300"] .sta-rail {
			position: sticky;
			top: 5.5rem;
			display: flex;
			gap: 0.7rem;
			padding-top: 0.35rem;
			align-self: start;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-track {
			position: relative;
			width: 2px;
			border-radius: 2px;
			background: var(--sta-hair);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-fill {
			position: absolute;
			inset: 0 0 auto 0;
			height: 0%;
			border-radius: 2px;
			background: var(--primary);
			transition: height 0.18s linear;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 1.15rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-item {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			opacity: 0.42;
			transition:
				opacity 0.3s ease,
				color 0.3s ease;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-item.is-active {
			opacity: 1;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-num {
			font-family: var(--sta-mono);
			font-size: 0.76rem;
			font-weight: 600;
			color: var(--sta-ink-faint);
			transition: color 0.3s ease;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-item.is-active .sta-rail-num {
			color: var(--primary);
		}
		/* The chapter name is revealed beside the active number only, so the
		   spine stays quiet and never competes with the sidebar contents. */
		[data-article-design="897765e061d7b61b4300"] .sta-rail-label {
			font-size: 0.68rem;
			line-height: 1.3;
			white-space: nowrap;
			color: var(--sta-ink-soft);
			opacity: 0;
			transform: translateX(-4px);
			transition:
				opacity 0.3s ease,
				transform 0.3s ease;
			pointer-events: none;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-rail-item.is-active .sta-rail-label {
			opacity: 1;
			transform: none;
		}

		/* ── chapters ───────────────────────────────────────── */
		[data-article-design="897765e061d7b61b4300"] .sta-chapter {
			position: relative;
			padding-block: clamp(2rem, 4vw, 3.25rem);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter + .sta-chapter {
			border-top: 1px solid var(--sta-hair);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-head {
			display: flex;
			align-items: center;
			gap: 0.7rem;
			margin-bottom: 1.5rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-num {
			font-family: var(--sta-mono);
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			color: var(--primary);
			padding: 0.18rem 0.45rem;
			border: 1px solid var(--sta-tint-strong);
			border-radius: 5px;
			background: var(--sta-tint);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-line {
			flex: 0 0 1.6rem;
			height: 1px;
			background: var(--sta-hair);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-text {
			font-family: var(--sta-mono);
			font-size: 0.68rem;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--sta-ink-faint);
		}

		/* body typography (prose disabled on SourceBlock) */
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body {
			max-width: none;
			line-height: 1.85;
		}
		[data-article-design="897765e061d7b61b4300"]
			.sta-chapter-body
			> [data-source-block] {
			margin-block: 1.15rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body > :first-child {
			margin-top: 0;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body h2 {
			font-size: clamp(1.45rem, 2.4vw, 1.95rem);
			font-weight: 750;
			line-height: 1.35;
			margin: 0.25rem 0 1rem;
			letter-spacing: -0.01em;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body h3 {
			font-size: 1.15rem;
			font-weight: 700;
			line-height: 1.5;
			margin: 2rem 0 0.6rem;
			padding-left: 0.7rem;
			border-left: 3px solid var(--sta-tint-strong);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body p {
			margin-block: 0.95rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body ul,
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body ol {
			margin-block: 0.95rem;
			padding-left: 1.35rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body li {
			margin-block: 0.4rem;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body li::marker {
			color: var(--primary);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body a {
			color: var(--primary);
			text-decoration: underline;
			text-underline-offset: 3px;
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body strong {
			font-weight: 700;
			color: color-mix(in srgb, currentColor 92%, transparent);
		}
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body code {
			font-family: var(--sta-mono);
			font-size: 0.88em;
			padding: 0.1em 0.36em;
			border-radius: 4px;
			background: var(--sta-tint);
		}

		/* inline math gets a subtle instrument look */
		[data-article-design="897765e061d7b61b4300"] .sta-chapter-body .katex-display {
			margin: 1.4rem 0;
			padding: 1rem 0.9rem;
			border: 1px solid var(--sta-hair);
			border-left: 2px solid var(--sta-tint-strong);
			border-radius: 0 8px 8px 0;
			background: var(--sta-panel);
			overflow-x: auto;
