		@media (prefers-reduced-motion: reduce) {
			[data-article-design="897765e061d7b61b4300"] .sta-led,
			[data-article-design="897765e061d7b61b4300"] .sta-scope-trace,
			[data-article-design="897765e061d7b61b4300"] .sta-scope-area,
