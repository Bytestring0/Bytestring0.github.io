---
import {
	lifeCountdownConfig as defaultLifeCountdownConfig,
	siteConfig,
} from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import type {
	LifeCountdownConfig,
	LifeCountdownHolidayConfig,
} from "../../types/config";
import LifeCountdownClient from "./LifeCountdownClient.svelte";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	config?: LifeCountdownConfig;
}

const { class: className, style, config } = Astro.props as Props;
const resolvedConfig = config ?? defaultLifeCountdownConfig;
const shouldRender =
	config?.enable ?? defaultLifeCountdownConfig.enable ?? true;

const timezone =
	typeof resolvedConfig.timezone === "number"
		? resolvedConfig.timezone
		: (siteConfig.timeZone ?? 0);

const holidays: LifeCountdownHolidayConfig[] = Array.isArray(
	resolvedConfig.holidays,
)
	? [...resolvedConfig.holidays]
	: [];

const labels = {
	today: i18n(I18nKey.lifeCountdownToday),
	week: i18n(I18nKey.lifeCountdownWeek),
	month: i18n(I18nKey.lifeCountdownMonth),
	year: i18n(I18nKey.lifeCountdownYear),
	remaining: i18n(I18nKey.lifeCountdownRemaining),
	completed: i18n(I18nKey.lifeCountdownCompleted),
	nextHoliday: i18n(I18nKey.lifeCountdownNextHoliday),
	holidayCountdown: i18n(I18nKey.lifeCountdownHolidayCountdown),
	noHoliday: i18n(I18nKey.lifeCountdownNoHoliday),
	day: i18n(I18nKey.day),
	hour: i18n(I18nKey.hour),
	minute: i18n(I18nKey.minute),
	second: i18n(I18nKey.second),
};
---
{shouldRender && (
	<WidgetLayout
		id="life-countdown"
		name={i18n(I18nKey.lifeCountdown)}
		class={className}
		style={style}
	>
		<LifeCountdownClient
			client:load
			timezone={timezone}
			holidays={holidays}
			labels={labels}
		/>
	</WidgetLayout>
)}
