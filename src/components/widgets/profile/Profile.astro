---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../../config";
import { url } from "../../../utils/url-utils";
import ImageWrapper from "../../misc/ImageWrapper.astro";
import TypewriterText from "../../TypewriterText.astro";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
---

<div class="profile-card card-base">
    <a aria-label="Go to About Page" href={url('/about/')} class="profile-avatar-link">
        <ImageWrapper src={profileConfig.avatar || ""} alt="Profile Image of the Author" class="profile-avatar"></ImageWrapper>
    </a>

    <div class="profile-body">
        <p class="profile-name">{profileConfig.name}</p>

        <p class="profile-bio">
            {profileConfig.typewriter?.enable ? (
                <TypewriterText
                    text={profileConfig.bio || ""}
                    speed={profileConfig.typewriter.speed}
                    class="inline-block"
                />
            ) : (
                profileConfig.bio
            )}
        </p>

        <div class="profile-links">
            {profileConfig.links.map(item =>
                <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="profile-link">
                    <Icon name={item.icon} class="text-[0.95rem]"></Icon>
                    <span>{item.name}</span>
                </a>
            )}
        </div>

        <div class="umami-stats-container hidden">
            <div class="profile-stats">
                <Icon name="fa7-solid:eye" class="text-[0.7rem]" />
                <span class="site-stats-display">{i18n(I18nKey.profileStatsLoading)}</span>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-card {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 1.15rem 1rem;
    }

    .profile-avatar-link {
        flex: none;
        width: 3rem;
        height: 3rem;
        border-radius: 999px;
        overflow: hidden;
        border: 1px solid rgb(var(--n-4));
        transition: border-color 150ms var(--ease);
    }

    .profile-avatar-link:hover {
        border-color: rgb(var(--n-5));
    }

    .profile-body {
        min-width: 0;
        flex: 1;
    }

    .profile-name {
        margin: 0;
        font-size: 0.92rem;
        font-weight: 500;
        color: rgb(var(--n-10));
    }

    .profile-bio {
        margin: 0.2rem 0 0;
        font-size: 0.76rem;
        line-height: 1.65;
        color: rgb(var(--n-8));
    }

    .profile-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        margin-top: 0.55rem;
    }

    .profile-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        height: 1.55rem;
        padding: 0 0.5rem;
        border: 1px solid rgb(var(--n-4));
        border-radius: 999px;
        font-size: 0.68rem;
        color: rgb(var(--n-8));
        transition:
            border-color 150ms var(--ease),
            color 150ms var(--ease);
    }

    .profile-link:hover {
        border-color: rgb(var(--n-5));
        color: rgb(var(--n-10));
    }

    .profile-stats {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.55rem;
        font-size: 0.68rem;
        color: rgb(var(--n-7));
    }
</style>

<script is:inline define:vars={{
    profileStatsPageViews: i18n(I18nKey.profileStatsPageViews),
    profileStatsVisits: i18n(I18nKey.profileStatsVisits),
    profileStatsUnavailable: i18n(I18nKey.profileStatsUnavailable)
}}>
    function generateStatsText(pageViews, visits) {
        return `${profileStatsPageViews} ${pageViews} · ${profileStatsVisits} ${visits}`;
    }

    async function fetchSiteStats(isRetry = false) {
        const container = document.querySelector('.umami-stats-container');

        if (!window.oddmisc) {
            if (!isRetry) {
                setTimeout(() => fetchSiteStats(true), 500);
            } else {
                container?.classList.add('hidden');
            }
            return;
        }

        try {
            const stats = await window.oddmisc.getSiteStats();
            const pageViews = stats.pageviews || 0;
            const visits = stats.visits || 0;

            if (pageViews === 0 && visits === 0) {
                container?.classList.add('hidden');
                return;
            }

            container?.classList.remove('hidden');
            document.querySelectorAll('.site-stats-display').forEach(el => {
                el.textContent = generateStatsText(pageViews, visits);
            });
        } catch (error) {
            console.error('Error fetching site stats:', error);
            container?.classList.add('hidden');
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => fetchSiteStats());
    } else {
        fetchSiteStats();
    }
</script>
