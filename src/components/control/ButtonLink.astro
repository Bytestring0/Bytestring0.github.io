---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="cat-link">
    <span class="cat-name"><slot /></span>
    { badge !== undefined && badge !== null && badge !== '' && (
        <span class="cat-count">{badge}</span>
    )}
</a>

<style>
    .cat-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        height: 2rem;
        padding: 0 0.45rem;
        border-radius: var(--r-sm);
        color: rgb(var(--n-8));
        font-size: 0.82rem;
        transition:
            color 150ms var(--ease),
            background-color 150ms var(--ease);
    }

    .cat-link:hover {
        color: rgb(var(--n-10));
        background: rgb(var(--n-3));
    }

    .cat-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cat-count {
        flex: none;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: rgb(var(--n-6));
        font-variant-numeric: tabular-nums;
    }
</style>
