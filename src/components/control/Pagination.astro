---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;
const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<nav class:list={[className, "pager"]} style={style} aria-label="分页">
    <a
        href={page.url.prev || ""}
        aria-label="上一页"
        class:list={["pager-step", { "pointer-events-none opacity-40": !page.url.prev }]}
    >
        <Icon name="material-symbols:chevron-left-rounded" />
    </a>

    <span class="pager-numbers">
        {pages.map((p) => {
            if (p == HIDDEN)
                return <span class="pager-gap">…</span>;
            if (p == page.currentPage)
                return <span class="pager-current" aria-current="page">{p}</span>;
            return (
                <a href={url(getPageUrl(p))} aria-label={`第 ${p} 页`} class="pager-link">
                    {p}
                </a>
            );
        })}
    </span>

    <a
        href={page.url.next || ""}
        aria-label="下一页"
        class:list={["pager-step", { "pointer-events-none opacity-40": !page.url.next }]}
    >
        <Icon name="material-symbols:chevron-right-rounded" />
    </a>
</nav>

<style>
    .pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        margin-top: 1.75rem;
    }

    .pager-step {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: var(--r-sm);
        color: rgb(var(--n-7));
        transition:
            color 150ms var(--ease),
            background-color 150ms var(--ease);
    }

    .pager-step:hover {
        color: rgb(var(--n-10));
        background: rgb(var(--n-3));
    }

    .pager-step :global(svg) {
        width: 1.15rem;
        height: 1.15rem;
    }

    .pager-numbers {
        display: flex;
        align-items: center;
        gap: 0.15rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
    }

    .pager-link,
    .pager-current,
    .pager-gap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.9rem;
        height: 1.9rem;
        padding: 0 0.3rem;
        border-radius: var(--r-sm);
    }

    .pager-link {
        color: rgb(var(--n-8));
        transition:
            color 150ms var(--ease),
            background-color 150ms var(--ease);
    }

    .pager-link:hover {
        color: rgb(var(--n-10));
        background: rgb(var(--n-3));
    }

    .pager-current {
        color: rgb(var(--n-10));
        border: 1px solid rgb(var(--n-5));
        background: rgb(var(--n-1));
    }

    .pager-gap {
        color: rgb(var(--n-6));
    }
</style>
