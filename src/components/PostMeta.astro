---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

export interface Props {
	published: Date;
	updated?: Date;
	category?: string;
	tags?: string[];
	hideUpdateDate?: boolean;
	hideTagsForMobile?: boolean;
	isHome?: boolean;
	className?: string;
	id?: string;
	showOnlyBasicMeta?: boolean;
	words?: number;
	minutes?: number;
	showWordCount?: boolean;
}

const {
	published,
	updated,
	category,
	tags,
	hideUpdateDate,
	hideTagsForMobile,
	isHome,
	className = "",
	id,
	showOnlyBasicMeta = false,
	words,
	showWordCount = false,
} = Astro.props;
---

<div class:list={["post-meta-root flex flex-wrap items-center gap-2 gap-x-3.5 gap-y-2", className]}>
    <!-- publish date -->
    <div class="flex items-center">
        <div class="post-meta-icon">
            <Icon name="material-symbols:calendar-today-outline-rounded" />
        </div>
        <span class="post-meta-text">{formatDateToYYYYMMDD(published)}</span>
    </div>

    <!-- update date -->
    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="flex items-center">
            <div class="post-meta-icon">
                <Icon name="material-symbols:edit-calendar-outline-rounded" />
            </div>
            <span class="post-meta-text">{formatDateToYYYYMMDD(updated)}</span>
        </div>
    )}

    <!-- categories -->
    <div class="flex items-center">
        <div class="post-meta-icon">
            <Icon name="material-symbols:book-2-outline-rounded" />
        </div>
        <a href={getCategoryUrl(category || '')} aria-label={`View all posts in the ${category} category`}
           class="post-meta-link">
            {category || i18n(I18nKey.uncategorized)}
        </a>
    </div>

    <!-- word count -->
    {showWordCount && words && (
        <div class="flex items-center">
            <div class="post-meta-icon">
                <Icon name="material-symbols:article-outline-rounded" />
            </div>
            <span class="post-meta-text">
                {words} {words > 1 ? i18n(I18nKey.wordsCount) : i18n(I18nKey.wordCount)}
            </span>
        </div>
    )}

    <!-- tags -->
    {!showOnlyBasicMeta && (
        <div class:list={["items-center", {"flex": !hideTagsForMobile, "hidden md:flex": hideTagsForMobile}]}>
            <div class="post-meta-icon">
                <Icon name="material-symbols:tag-rounded" />
            </div>
            <div class="flex flex-row flex-nowrap items-center">
                {(tags && tags.length > 0) && tags.map((tag, i) => (
                    <>
                        <div class:list={[{"hidden": i == 0}, "post-meta-sep"]}>/</div>
                        <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag.trim()} tag`}
                           class="post-meta-link">
                            {tag.trim()}
                        </a>
                    </>
                ))}
                {!(tags && tags.length > 0) && <div class="post-meta-text">{i18n(I18nKey.noTags)}</div>}
            </div>
        </div>
    )}

    <!-- 访问量 -->
    {!isHome && id && (
        <div class="flex items-center umami-page-views hidden" data-id={id}>
            <div class="post-meta-icon">
                <Icon name="material-symbols:visibility-outline-rounded" />
            </div>
            <span class="post-meta-text page-views-display">{i18n(I18nKey.pageViewsLoading)}</span>
        </div>
    )}
</div>

{!isHome && id && (
<script is:inline define:vars={{
    pageViewsText: i18n(I18nKey.profileStatsPageViews),
    visitsText: i18n(I18nKey.profileStatsVisits)
}}>
    function generateStatsText(pageViews, visits) {
        return `${pageViewsText} ${pageViews} · ${visitsText} ${visits}`;
    }

    async function fetchPageViews() {
        const container = document.querySelector('.umami-page-views');
        
        if (!window.oddmisc) {
            container?.classList.add('hidden');
            return;
        }

        const id = container?.dataset.id;
        if (!id) return;

        try {
            const stats = await window.oddmisc.getStats(`/posts/${id}/`);
            const pageViews = stats.pageviews || 0;
            const visits = stats.visits || 0;

            if (pageViews === 0 && visits === 0) {
                container?.classList.add('hidden');
                return;
            }

            container?.classList.remove('hidden');
            container.querySelector('.page-views-display').textContent = generateStatsText(pageViews, visits);
        } catch (error) {
            console.error('Error fetching page views:', error);
            container?.classList.add('hidden');
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fetchPageViews);
    } else {
        fetchPageViews();
    }
</script>
)}

<style>
    .post-meta-root {
        color: rgb(var(--n-8));
        font-size: 0.78rem;
    }

    .post-meta-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.3rem;
        color: rgb(var(--n-6));
    }

    .post-meta-icon :global(svg) {
        width: 0.95rem;
        height: 0.95rem;
    }

    .post-meta-text {
        color: rgb(var(--n-8));
        font-variant-numeric: tabular-nums;
    }

    .post-meta-sep {
        margin: 0 0.35rem;
        color: rgb(var(--n-5));
        font-size: 0.75rem;
    }

    :global(.post-meta-link) {
        color: rgb(var(--n-8));
        border-radius: var(--r-sm);
        padding: 0.05rem 0.15rem;
        transition: color 150ms var(--ease);
    }

    :global(.post-meta-link:hover) {
        color: rgb(var(--n-10));
    }
</style>
