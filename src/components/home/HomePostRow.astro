---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/url-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	index: number;
	style?: string;
}

const { entry, index, style } = Astro.props;
const { title, published, category } = entry.data;
const url = getPostUrl(entry);
---

<article class="post-row post-card-item" style={style}>
	<a class="post-row-link" href={url} aria-label={title}>
		<h2 class="post-row-title">{title}</h2>
		{category && <span class="post-row-cat">{category}</span>}
		<span class="post-row-leader" aria-hidden="true"></span>
		<time class="post-row-date" datetime={published.toISOString()}>
			{formatDateToYYYYMMDD(published)}
		</time>
	</a>
</article>

<style>
	.post-row-link {
		display: flex;
		align-items: baseline;
		padding: 0.62rem 0.25rem;
		line-height: 1.7;
	}

	.post-row-title {
		margin: 0;
		min-width: 0;
		flex: 0 1 auto;
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 500;
		color: rgb(var(--n-10));
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: color 150ms var(--ease);
	}

	.post-row-cat {
		flex: none;
		margin-left: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.02em;
		color: rgb(var(--n-7));
	}

	.post-row-leader {
		flex: 1 1 1.5rem;
		min-width: 1.5rem;
		margin: 0 0.1rem 0 0.75rem;
		border-bottom: 1px dotted rgb(var(--n-5));
		transition: border-color 150ms var(--ease);
	}

	.post-row-date {
		flex: none;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgb(var(--n-7));
		font-variant-numeric: tabular-nums;
	}

	.post-row-link:hover .post-row-title {
		color: rgb(var(--accent));
	}

	.post-row-link:hover .post-row-leader {
		border-bottom-style: solid;
		border-color: rgb(var(--accent-line) / 0.45);
	}

	.post-row-link:focus-visible {
		outline: 2px solid rgb(var(--accent-line));
		outline-offset: 2px;
		border-radius: 4px;
	}

	@media (max-width: 767px) {
		.post-row-link {
			display: block;
			padding: 0.72rem 0.1rem;
		}

		.post-row-title {
			display: inline;
			white-space: normal;
			font-size: 1.02rem;
		}

		.post-row-cat {
			display: inline;
			margin-left: 0.55em;
		}

		.post-row-leader {
			display: none;
		}

		.post-row-date {
			display: block;
			margin-top: 0.15rem;
		}
	}
</style>
