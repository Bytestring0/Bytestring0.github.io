---
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import ProjectsOverview from "../components/projects/ProjectsOverview.astro";
import ProjectsTimeline from "../components/projects/ProjectsTimeline.astro";

if (!siteConfig.featurePages.projects) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.projects);
const subtitle = i18n(I18nKey.projectsSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
  <script>
    import('../scripts/right-sidebar-layout.js');
  </script>

  <header class="page-head">
    <h1>{title}</h1>
  </header>

  <ProjectsOverview />

  <ProjectsTimeline />
</MainGridLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 2.5rem 0 1.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--n-7));
  }

  .page-head h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: rgb(var(--n-10));
  }

  .page-lede {
    margin: 0;
    font-size: 0.88rem;
    color: rgb(var(--n-8));
  }
</style>
