---
import LakeLayout from "../layouts/LakeLayout.astro";
import Icon from "../components/lake/Icon.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrl } from "../utils/url-utils";
import { initPostIdMap } from "../utils/permalink-utils";
const posts = await getSortedPosts();
initPostIdMap(posts);
const index = posts.map((post) => ({
	id: post.id,
	title: post.data.title,
	url: getPostUrl(post),
	date: post.data.published.toISOString(),
	category: post.data.category || "未分类",
	tags: post.data.tags,
	text: post.data.encrypted
		? ""
		: `${post.data.description} ${post.body || ""}`
				.replace(/!\[\[[^\]\r\n]+\]\]/g, " ")
				.replace(/\[\[([^|\]\r\n]+)(?:\|([^\]\r\n]+))?\]\]/g, "$1 $2")
				.replace(/!\[[^\]]*\]\([^)]*\)|<[^>]+>/g, " ")
				.replace(/[#*`>|]/g, ""),
}));
---

<LakeLayout title="搜索" view="search"
	><section class="search-panel">
		<form class="search-form" role="search" data-no-pan>
			<label class="sr-only" for="lake-search">搜索文章</label><Icon
				name="search"
				size={20}
			/><input
				id="lake-search"
				name="q"
				type="search"
				placeholder="搜索标题、分类或正文"
				autocomplete="off"
			/><button type="submit" aria-label="搜索"
				><Icon name="right" size={19} /></button
			>
		</form><div class="search-meta">
			<h1 data-search-heading>最近文章</h1><p
				class="search-status"
				role="status"
				aria-live="polite"
			>
			</p>
		</div><div class="search-results-list" data-search-results></div>
	</section><script
		is:inline
		id="lake-search-index"
		type="application/json"
		set:html={JSON.stringify(index).replaceAll(
			"<",
			String.fromCharCode(92) + "u003c",
		)}
	/></LakeLayout
>
