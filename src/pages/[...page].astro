---
import LakeLayout from "../layouts/LakeLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";
export async function getStaticPaths() {
	const posts = await getSortedPostsList();
	return Array.from(
		{ length: Math.max(1, Math.ceil(posts.length / 5)) },
		(_, i) => ({
			params: { page: i ? String(i + 1) : undefined },
			props: { legacy: i > 0 },
		}),
	);
}
if (Astro.props.legacy) return Astro.redirect("/archive/", 301);
---

<LakeLayout view="home" />
