---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import avatar from "../assets/images/avatar.png";
import LakeLayout from "../layouts/LakeLayout.astro";
import Icon from "../components/lake/Icon.astro";
import { profileConfig } from "../config";
import { getSortedPostsList } from "../utils/content-utils";
const entry = await getEntry("spec", "about");
const result = entry ? await render(entry) : null;
const Content = result?.Content;
const posts = (await getSortedPostsList()).sort(
	(a, b) => +b.data.published - +a.data.published,
);
---

<LakeLayout title="关于" view="about"
	><section class="about-profile">
		<aside class="profile-identity">
			<Image
				src={avatar}
				width={116}
				height={116}
				alt={profileConfig.name}
			/><h1>{profileConfig.name}</h1><p>{profileConfig.bio}</p><nav
				aria-label="个人链接"
			>
				{
					profileConfig.links.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="me noopener noreferrer"
						>
							{link.name}
							<Icon name="external" size={14} />
						</a>
					))
				}<a href="/rss/">RSS<Icon name="external" size={14} /></a>
			</nav>
		</aside><div class="profile-content">
			{
				Content && (
					<div class="about-content">
						<Content />
					</div>
				)
			}<section class="profile-recent">
				<header>
					<h2>最近文章</h2><a href="/archive/"
						>全部文章 <Icon name="right" size={14} /></a
					>
				</header>{
					posts.slice(0, 3).map((post) => (
						<a class="recent-post" href={post.url}>
							<>
								<time>
									{post.data.published
										.toISOString()
										.slice(0, 10)}
								</time>
								<span>{post.data.title}</span>
								<Icon name="right" size={15} />
							</>
						</a>
					))
				}
			</section>
		</div>
	</section></LakeLayout
>
