---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";

const sortedPostsList = await getSortedPostsList();

const posts = sortedPostsList.map((post) => ({
    ...post,
    data: {
        ...post.data,
        category: post.data.category === null ? undefined : post.data.category,
    },
}));

const tags = [...new Set(posts.flatMap(post => post.data.tags))];
const categories = [...new Set(posts.map(post => post.data.category).filter((c): c is string => typeof c === "string"))];
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <script>
        import('../scripts/right-sidebar-layout.js');
    </script>

    <header class="page-head">
        <h1>{i18n(I18nKey.archive)}</h1>
    </header>

    <ArchivePanel
            sortedPosts={posts}
            tags={tags}
            categories={categories}
            client:only="svelte"
    ></ArchivePanel>
</MainGridLayout>

<style>
    .page-head {
        padding: 2.5rem 0 1.5rem;
    }

    .eyebrow {
        margin: 0 0 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgb(var(--n-7));
    }

    .page-head h1 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(1.9rem, 3.2vw, 2.5rem);
        font-weight: 500;
        letter-spacing: -0.025em;
        color: rgb(var(--n-10));
    }

    .page-lede {
        margin: 0.6rem 0 0;
        font-size: 0.88rem;
        color: rgb(var(--n-8));
    }
</style>
