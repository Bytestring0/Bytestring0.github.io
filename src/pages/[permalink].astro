---
import Article from "../components/lake/Article.astro";
import { getSortedPosts } from "../utils/content-utils";
import {
	initPostIdMap,
	hasCustomPermalink,
	generatePermalinkSlug,
} from "../utils/permalink-utils";
import { permalinkConfig } from "../config";
export async function getStaticPaths() {
	const posts = await getSortedPosts();
	initPostIdMap(posts);
	return posts.flatMap((entry) => {
		const permalink = hasCustomPermalink(entry)
			? entry.data.permalink!.replace(/^\/+|\/+$/g, "")
			: permalinkConfig.enable
				? generatePermalinkSlug(entry)
				: null;
		return permalink ? [{ params: { permalink }, props: { entry } }] : [];
	});
}
const { entry } = Astro.props;
---

<Article entry={entry} />
