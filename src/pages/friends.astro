---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import { siteConfig } from "../config";
import { getShuffledFriendsList } from "../data/friends";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

if (!siteConfig.featurePages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);
const friendsList = getShuffledFriendsList();

const allTags = Array.from(new Set(friendsList.flatMap((item) => item.tags)));
---

<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
	<script is:inline>
		window.isFriendsPage = true;
	</script>
	<script>
		import('../scripts/right-sidebar-layout.js');
	</script>

	<header class="friends-head">
		<h1>{i18n(I18nKey.friends)}</h1>
	</header>

	<div class="friends-tools">
		<label class="friends-search">
			<svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
					d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			<input
				type="text"
				id="friend-search"
				placeholder={i18n(I18nKey.friendsSearchPlaceholder)}
				aria-label={i18n(I18nKey.friendsSearchPlaceholder)}
			/>
		</label>

		<div class="filter-container" role="group" aria-label="标签筛选">
			<button class="filter-tag active" data-tag="all">{i18n(I18nKey.friendsFilterAll)}</button>
			{allTags.map(tag => (
				<button class="filter-tag" data-tag={tag}>{tag}</button>
			))}
		</div>
	</div>

	<div id="friends-grid" class="friends-grid">
		{friendsList.map((item, index) => (
			<a
				href={item.siteurl}
				target="_blank"
				rel="noopener noreferrer"
				class="friend-row"
				style={`--i: ${index}`}
				data-title={item.title.toLowerCase()}
				data-desc={item.desc.toLowerCase()}
				data-tags={item.tags.join(',')}
			>
				<span class="friend-avatar">
					<img src={item.imgurl.trim()} alt={item.title} loading="lazy" referrerpolicy="no-referrer" />
				</span>

				<span class="friend-text">
					<span class="friend-name">{item.title}</span>
					<span class="friend-desc">{item.desc}</span>
				</span>

				<span class="friend-tags">
					{item.tags.map(tag => <span>#{tag}</span>)}
				</span>

				<svg class="friend-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
						d="M7 17L17 7M17 7H9M17 7v8"></path>
				</svg>
			</a>
		))}
	</div>

	<div id="no-results" class="friends-empty" hidden>
		<p>{i18n(I18nKey.friendsNoResults)}</p>
	</div>

	<div id="friends-copy-success-text" style="display: none;">{i18n(I18nKey.friendsCopySuccess)}</div>

	<article class="friends-note">
		<Markdown class="mt-0">
			<Content />
		</Markdown>
	</article>
</MainGridLayout>

<script>
	function initFriendsFilter() {
		const input = document.getElementById("friend-search") as HTMLInputElement | null;
		const gridEl = document.getElementById("friends-grid");
		const empty = document.getElementById("no-results");
		if (!input || !gridEl) return;
		const grid: HTMLElement = gridEl;

		const rows = Array.from(grid.querySelectorAll<HTMLElement>(".friend-row"));
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-tag"));

		let term = "";
		let tag = "all";

		function apply() {
			let visible = 0;
			for (const row of rows) {
				const title = (row.dataset.title || "").toLowerCase();
				const desc = (row.dataset.desc || "").toLowerCase();
				const tags = row.dataset.tags || "";
				const hitSearch = !term || title.includes(term) || desc.includes(term);
				const hitTag = tag === "all" || tags.split(",").includes(tag);
				const show = hitSearch && hitTag;
				row.classList.toggle("is-hidden", !show);
				if (show) visible++;
			}
			if (empty) empty.hidden = visible > 0;
			grid.classList.toggle("is-empty", visible === 0);
		}

		input.addEventListener("input", () => {
			term = input.value.trim().toLowerCase();
			apply();
		});

		for (const button of buttons) {
			button.addEventListener("click", () => {
				for (const b of buttons) b.classList.remove("active");
				button.classList.add("active");
				tag = button.dataset.tag || "all";
				apply();
			});
		}

		apply();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initFriendsFilter);
	} else {
		initFriendsFilter();
	}
</script>

<style>
	.friends-head {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 2.5rem 0 1.5rem;
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgb(var(--n-7));
	}

	.friends-head h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.9rem, 3.2vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		color: rgb(var(--n-10));
	}

	.page-lede {
		margin: 0.15rem 0 0;
		font-size: 0.9rem;
		color: rgb(var(--n-8));
	}

	.friends-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		padding-bottom: 1.1rem;
		border-bottom: 1px solid rgb(var(--n-4));
	}

	.friends-search {
		position: relative;
		display: flex;
		align-items: center;
		flex: 1 1 15rem;
		max-width: 22rem;
	}

	.search-icon {
		position: absolute;
		left: 0.7rem;
		width: 1rem;
		height: 1rem;
		color: rgb(var(--n-6));
		pointer-events: none;
	}

	#friend-search {
		width: 100%;
		height: 2.2rem;
		padding: 0 0.8rem 0 2.1rem;
		border: 1px solid rgb(var(--n-4));
		border-radius: 999px;
		background: transparent;
		font-size: 0.82rem;
		color: rgb(var(--n-10));
		outline: none;
		transition: border-color 150ms var(--ease), background-color 150ms var(--ease);
	}

	#friend-search::placeholder {
		color: rgb(var(--n-6));
	}

	#friend-search:focus {
		border-color: rgb(var(--accent) / 0.5);
		background: rgb(var(--n-1));
	}

	.filter-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.filter-tag {
		height: 1.85rem;
		padding: 0 0.7rem;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		font-size: 0.76rem;
		color: rgb(var(--n-8));
		cursor: pointer;
		transition: border-color 150ms var(--ease), color 150ms var(--ease), background-color 150ms var(--ease);
	}

	.filter-tag:hover {
		color: rgb(var(--n-10));
		background: rgb(var(--n-3));
	}

	.filter-tag.active {
		border-color: rgb(var(--n-5));
		color: rgb(var(--n-10));
		background: rgb(var(--n-1));
	}

	.friends-grid {
		display: flex;
		flex-direction: column;
		margin-top: 0.35rem;
	}

	.friend-row {
		display: grid;
		grid-template-columns: 2.6rem minmax(0, 1fr) auto 1.1rem;
		align-items: center;
		gap: 0.9rem;
		padding: 0.85rem 0.6rem;
		border-bottom: 1px solid rgb(var(--n-4));
		opacity: 0;
		transform: translateY(8px);
		animation: friend-in 420ms var(--ease) forwards;
		animation-delay: calc(var(--i) * 45ms);
		transition: background-color 180ms var(--ease);
	}

	.friend-row:hover {
		background: rgb(var(--n-1) / 0.75);
	}

	.friend-row.is-hidden {
		display: none;
	}

	@keyframes friend-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.friend-avatar {
		width: 2.6rem;
		height: 2.6rem;
		border-radius: var(--r-md);
		overflow: hidden;
		border: 1px solid rgb(var(--n-4));
		background: rgb(var(--n-3));
	}

	.friend-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 350ms var(--ease);
	}

	.friend-row:hover .friend-avatar img {
		transform: scale(1.06);
	}

	.friend-text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.friend-name {
		font-size: 0.92rem;
		font-weight: 500;
		color: rgb(var(--n-10));
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 180ms var(--ease);
	}

	.friend-row:hover .friend-name {
		color: rgb(var(--accent));
	}

	.friend-desc {
		font-size: 0.78rem;
		color: rgb(var(--n-7));
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.friend-tags {
		display: flex;
		gap: 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: rgb(var(--n-6));
	}

	.friend-arrow {
		width: 1rem;
		height: 1rem;
		color: rgb(var(--n-6));
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 180ms var(--ease), transform 180ms var(--ease), color 180ms var(--ease);
	}

	.friend-row:hover .friend-arrow {
		opacity: 1;
		transform: translateX(0);
		color: rgb(var(--accent));
	}

	.friends-empty {
		padding: 3rem 0;
		text-align: center;
		font-size: 0.86rem;
		color: rgb(var(--n-7));
	}

	.friends-note {
		margin-top: 2.5rem;
	}

	@media (max-width: 768px) {
		.friend-row {
			grid-template-columns: 2.3rem minmax(0, 1fr) 1rem;
			gap: 0.75rem;
		}

		.friend-avatar {
			width: 2.3rem;
			height: 2.3rem;
		}

		.friend-tags {
			display: none;
		}

		.friends-tools {
			align-items: stretch;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.friend-row {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>