---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";
import { getTagUrl } from "@utils/url-utils";

const posts = await getSortedPostsList();
const tagCounts = posts.reduce(
	(acc, post) => {
		for (const tag of post.data.tags ?? []) {
			acc.set(tag, (acc.get(tag) ?? 0) + 1);
		}
		return acc;
	},
	new Map<string, number>(),
);

const tags = [...tagCounts.entries()].sort((a, b) =>
	a[0].localeCompare(b[0], "zh-CN"),
);
const maxCount = Math.max(...tags.map(([, count]) => count), 1);
---

<MainGridLayout title="标签">
	<header class="page-head">
		<h1>标签</h1>
	</header>

	<div class="tag-grid">
		{tags.map(([tag, count], index) => (
			<a
				href={getTagUrl(tag)}
				class="tag-item"
				style={`--weight: ${Math.max(0.85, count / maxCount)}; --i: ${index}`}
			>
				<span class="tag-index">{String(index + 1).padStart(2, "0")}</span>
				<span class="tag-name">{tag}</span>
				<span class="tag-count">{count}</span>
			</a>
		))}
	</div>
</MainGridLayout>

<style>
	.page-head {
		padding: 2.5rem 0 1.5rem;
		border-bottom: 1px solid rgb(var(--n-4));
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgb(var(--n-7));
	}

	.page-head h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.9rem, 3.2vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		color: rgb(var(--n-10));
	}

	.page-lede {
		margin: 0.6rem 0 0;
		font-size: 0.88rem;
		color: rgb(var(--n-8));
	}

	.tag-grid {
		display: flex;
		flex-direction: column;
		margin-top: 0.5rem;
	}

	.tag-item {
		display: grid;
		grid-template-columns: 2.2rem minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.62rem 0.4rem;
		border-bottom: 1px solid rgb(var(--n-4));
		color: rgb(var(--n-9));
		opacity: 0;
		animation: tag-in 380ms var(--ease) forwards;
		animation-delay: calc(var(--i) * 22ms);
		transition:
			background-color 180ms var(--ease),
			padding-left 200ms var(--ease);
	}

	.tag-item:hover {
		background: rgb(var(--n-1) / 0.75);
		padding-left: 0.7rem;
	}

	@keyframes tag-in {
		to {
			opacity: 1;
		}
	}

	.tag-index {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		color: rgb(var(--n-6));
		font-variant-numeric: tabular-nums;
	}

	.tag-name {
		font-size: calc(0.86rem + (var(--weight) - 0.85) * 0.42rem);
		color: rgb(var(--n-9));
		transition: color 180ms var(--ease);
	}

	.tag-item:hover .tag-name {
		color: rgb(var(--accent));
	}

	.tag-count {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: rgb(var(--n-6));
		font-variant-numeric: tabular-nums;
	}

	@media (prefers-reduced-motion: reduce) {
		.tag-item {
			opacity: 1;
			animation: none;
		}
	}
</style>
